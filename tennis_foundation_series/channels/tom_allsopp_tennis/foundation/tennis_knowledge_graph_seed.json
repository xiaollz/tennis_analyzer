  "nodes": [
    {"id":"T0","node_type":"principle","label":"受约束的稳定得分能力","definition":"在球员协调能力、来球、时间、空间与战术目标的约束下，形成稳定接触、有效球路与可恢复的下一拍。","domains":["general_principles"],"conditions":[],"evidence_ids":["E-channel"],"confidence":"medium","status":"cross_video_synthesis","limitations":["是知识工程归纳，不是频道的量化公式。"],"version":"1.0.0"},
    {"id":"T1.1","node_type":"principle","label":"协调能力匹配技术复杂度","definition":"技术发展需从球员当前协调能力可承受的最简版本开始，而非跳过基础直接叠加高级环节。","domains":["training_skill_acquisition","serve"],"conditions":[{"field":"skill_level","operator":"in","value":["beginner","intermediate"],"rationale":"初学与动作不稳定阶段尤其需要降低复杂度。"}],"evidence_ids":["E-servebeginner","E-groundserve"],"confidence":"high","status":"channel_teaching_claim","limitations":["进阶门槛应由实际表现而非训练时长决定。"],"version":"1.0.0"},
    {"id":"T2.1","node_type":"mechanism","label":"引拍—迈步同步","definition":"完整引拍与前脚迈步的时序同步使双手反手能够围绕支撑腿平衡旋转。","domains":["two_handed_backhand","movement_footwork"],"conditions":[{"field":"shot_family","operator":"eq","value":"two_handed_backhand","rationale":"该主张来自双手反手的组织方式。"}],"evidence_ids":["E-twohandtiming"],"confidence":"high","status":"channel_teaching_claim","limitations":["时间极短或极端跑动时应使用压缩版本。"],"version":"1.0.0"},
    {"id":"T2.2","node_type":"condition","label":"可用击球空间","definition":"球相对身体的位置、距离和高度使技术路径能在不挤塞的情况下完成。","domains":["movement_footwork","contact_geometry"],"conditions":[],"evidence_ids":["E-twohandtiming","E-followthrough"],"confidence":"medium","status":"cross_video_synthesis","limitations":["不同技术和球员身体条件的最佳空间不同。"],"version":"1.0.0"},
    {"id":"T2.3","node_type":"principle","label":"双打跟随球路补位","definition":"网前球员应依据球路、搭档处境与对方网前球员的位置动态补位，而非固定站位。","domains":["tactics_strategy","volley_overhead","movement_footwork"],"conditions":[{"field":"task_goal","operator":"eq","value":"doubles_positioning","rationale":"适用于双打网前空间覆盖。"}],"evidence_ids":["E-doubles"],"confidence":"high","status":"channel_teaching_claim","limitations":["具体移动取决于四位球员的位置、球质与风险偏好。"],"version":"1.0.0"},
    {"id":"T3.1","node_type":"mechanism","label":"身体—手臂—球拍连接","definition":"正手过渡阶段以躯干转动、手臂内收和底托方向的同步组织受控结构，而不是让手臂松散拖后。","domains":["forehand","trunk_shoulder_biomechanics","racket_hand_interface"],"conditions":[{"field":"shot_family","operator":"eq","value":"forehand","rationale":"来自正手连接性教学。"}],"evidence_ids":["E-forehandconnection"],"confidence":"high","status":"channel_teaching_claim","limitations":["准备阶段的放松不应被等同为全程紧绷。"],"version":"1.0.0"},
    {"id":"T3.2","node_type":"mechanism","label":"受控滞后","definition":"拍头相对手部的滞后被视为连接、路径和时序的结果，而非刻意松散或拖拍的目标。","domains":["forehand","racket_hand_interface"],"conditions":[],"evidence_ids":["E-forehandconnection"],"confidence":"high","status":"channel_teaching_claim","limitations":["普通视频只能观察外形，不能直接判定关节动力学。"],"version":"1.0.0"},
    {"id":"T3.3","node_type":"mechanism","label":"腿—躯干—肩—拍的发球时序","definition":"发球由后腿加载、前腿支撑/转移、躯干和肩部旋转、肘部领先、拍头释放组成；跳跃只有在不破坏该时序时才增加价值。","domains":["serve","trunk_shoulder_biomechanics"],"conditions":[{"field":"shot_family","operator":"eq","value":"serve","rationale":"适用于发球。"}],"evidence_ids":["E-weighttransfer","E-groundserve","E-servebeginner"],"confidence":"high","status":"cross_video_synthesis","limitations":["平台式与并步式站位、水平与身体能力会改变具体实现。"],"version":"1.0.0"},
    {"id":"T4.1","node_type":"mechanism","label":"动态握拍压力","definition":"握拍压力随挥拍阶段变化：引拍顶点/自然下落时降低，接触附近提高，随挥再下降。","domains":["forehand","racket_hand_interface"],"conditions":[{"field":"shot_family","operator":"eq","value":"forehand","rationale":"视频主要讨论正手底线击球。"}],"evidence_ids":["E-grippressure"],"confidence":"high","status":"channel_teaching_claim","limitations":["视频无法直接量化真实握力；百分比是教学线索。"],"version":"1.0.0"},
    {"id":"T4.2","node_type":"principle","label":"随挥作为路径与制动系统","definition":"随挥是击球路径的延续和减速组织；不同技术的随挥受拍面、关节保护和下一拍准备约束。","domains":["forehand","backhand","serve","volley_overhead","slice"],"conditions":[],"evidence_ids":["E-followthrough"],"confidence":"high","status":"channel_teaching_claim","limitations":["不应通过随挥静态外形反推接触前质量。"],"version":"1.0.0"},
    {"id":"T5.F","node_type":"technical_template","label":"正手连接—释放模板","definition":"可用击球空间、放松准备、连接性过渡、自然下降、接触稳定与可恢复随挥组成的正手条件化模板。","domains":["forehand"],"conditions":[{"field":"shot_family","operator":"eq","value":"forehand","rationale":"正手技术族。"}],"evidence_ids":["E-forehandconnection","E-grippressure","E-followthrough"],"confidence":"medium","status":"cross_video_synthesis","limitations":["不同握拍、来球与战术目标产生不同版本。"],"version":"1.0.0"},
    {"id":"T5.B2","node_type":"technical_template","label":"双反同步支撑模板","definition":"单元转体读取来球、引拍—迈步同步、正确脚尖方向、围绕前腿旋转并维持可用击球空间。","domains":["two_handed_backhand","backhand"],"conditions":[{"field":"shot_family","operator":"eq","value":"two_handed_backhand","rationale":"双手反手技术族。"}],"evidence_ids":["E-twohandtiming","E-followthrough"],"confidence":"high","status":"cross_video_synthesis","limitations":["并非所有高速来球都允许完整步入。"],"version":"1.0.0"},
    {"id":"T5.S","node_type":"technical_template","label":"发球渐进与投掷模板","definition":"从稳定入界和击打感出发，逐步建立投掷、肘部空间、握拍演进、腿—上身时序、旋转与随挥。","domains":["serve"],"conditions":[{"field":"shot_family","operator":"eq","value":"serve","rationale":"发球技术族。"}],"evidence_ids":["E-servebeginner","E-weighttransfer","E-groundserve","E-followthrough"],"confidence":"high","status":"cross_video_synthesis","limitations":["不得跳过协调能力的阶段门槛。"],"version":"1.0.0"},
    {"id":"T5.V","node_type":"technical_template","label":"截击短路径与空间覆盖模板","definition":"以稳定拍臂、掌根支撑、有限随挥和准备位恢复服务于网前反应与空间覆盖。","domains":["volley_overhead","movement_footwork"],"conditions":[{"field":"shot_family","operator":"eq","value":"volley","rationale":"截击技术族。"}],"evidence_ids":["E-followthrough","E-doubles"],"confidence":"medium","status":"cross_video_synthesis","limitations":["须结合来球速度、间距和双打站位。"],"version":"1.0.0"},
    {"id":"T7.1","node_type":"drill","label":"地面发球变量隔离","definition":"暂时去除跳跃，以更清楚地练习肩部旋转、抛球、肘部领先和上身时序。","domains":["serve","training_skill_acquisition"],"conditions":[{"field":"skill_level","operator":"in","value":["beginner","intermediate"],"rationale":"适合需要降低时序复杂度的球员。"}],"evidence_ids":["E-groundserve"],"confidence":"high","status":"channel_teaching_claim","limitations":["并非最终发球动作规范；需在稳定后重引入必要变量。"],"version":"1.0.0"},
    {"id":"T7.2","node_type":"safety_guardrail","label":"事实、假设与覆盖状态分离","definition":"仅有元数据的视频不能被表述为已提取内容；视频观察、机制假设与教学建议必须分别标注。","domains":["knowledge_management","agent","vlm"],"conditions":[],"evidence_ids":["E-channel"],"confidence":"high","status":"cross_video_synthesis","limitations":["需要界面、数据模型和人工审阅共同执行。"],"version":"1.0.0"}
