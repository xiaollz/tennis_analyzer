    {"id":"P0","node_type":"principle","label":"受约束的得分能力","definition":"在给定来球、时间、空间、身体与战术目标下，实现可进、有效、可恢复且可重复的击球。","domains":["general_principles"],"conditions":[],"evidence_ids":["E-channel"],"confidence":"medium","status":"cross_video_synthesis","limitations":["这是知识工程目标函数，不是直接物理测量公式。"],"version":"1.0.0"},
    {"id":"P2.1","node_type":"principle","label":"接收与预判","definition":"从对手击球和来球早期信息中提取线索，以便及时移动并组织接触。","domains":["vision_perception","movement"],"conditions":[],"evidence_ids":["E-receiving","E-peripheral"],"confidence":"high","status":"channel_teaching_claim","limitations":["需要区分训练情境与真实对抗的时间压力。"],"version":"1.0.0"},
    {"id":"P2.2","node_type":"condition","label":"理想击球空间","definition":"球相对身体的位置、距离、高度与时间窗口使目标技术能够在不挤塞的条件下执行。","domains":["contact_geometry","movement"],"conditions":[],"evidence_ids":["E-power","E-twohand"],"confidence":"high","status":"cross_video_synthesis","limitations":["理想空间随技术、来球与球员身体条件变化。"],"version":"1.0.0"},
    {"id":"P3.1","node_type":"mechanism","label":"胸廓相对骨盆的扭转","definition":"蓄力被建模为胸廓相对于骨盆的相对旋转，而不是肩髋整体同步转身。","domains":["trunk_shoulder_biomechanics","forehand"],"conditions":[{"field":"time_available","operator":"in","value":["medium","high"],"rationale":"完整蓄力需要准备时间。"}],"evidence_ids":["E-rotation"],"confidence":"high","status":"channel_teaching_claim","limitations":["被动防守或时间极少时不应强求完整形态。"],"version":"1.0.0"},
    {"id":"P3.2","node_type":"mechanism","label":"反向旋转平衡","definition":"通过支撑与髋部的反向组织抵消上体旋转动量，使输出后仍可稳定和恢复。","domains":["trunk_shoulder_biomechanics","movement"],"conditions":[{"field":"stance","operator":"in","value":["open","neutral"],"rationale":"不同支撑模式需不同平衡策略。"}],"evidence_ids":["E-rotation","E-singlefoot"],"confidence":"medium","status":"cross_video_synthesis","limitations":["单脚练习是教学约束，不代表比赛中必须单脚击球。"],"version":"1.0.0"},
    {"id":"P3.3","node_type":"mechanism","label":"肩胛与上背稳定基座","definition":"通过避免耸肩、建立上背支撑，为手臂与球拍的释放提供相对稳定的近端基础。","domains":["trunk_shoulder_biomechanics","forehand","backhand","serve"],"conditions":[],"evidence_ids":["E-racketflip","E-onehand","E-servefoundation"],"confidence":"high","status":"cross_video_synthesis","limitations":["普通视频无法直接测量肩胛运动或肌肉激活。"],"version":"1.0.0"},
    {"id":"P3.4","node_type":"mechanism","label":"近端脉冲与远端释放","definition":"髋部和躯干的加速—制动时序为手臂和拍头在适当窗口内释放创造条件。","domains":["trunk_shoulder_biomechanics","forehand","serve"],"conditions":[],"evidence_ids":["E-racketflip"],"confidence":"medium","status":"channel_teaching_claim","limitations":["视频可支持时序假设，但无法单凭外观证明关节力矩或因果。"],"version":"1.0.0"},
    {"id":"P4.1","node_type":"mechanism","label":"手—拍耦合","definition":"握拍几何、掌部贴合与阶段性压力使球员能感知和控制球拍的相对运动。","domains":["racket_hand_interface","forehand","serve"],"conditions":[],"evidence_ids":["E-racketflip","E-grip"],"confidence":"high","status":"channel_teaching_claim","limitations":["不同握拍与个体手型的感觉线索不同。"],"version":"1.0.0"},
    {"id":"P4.2","node_type":"mechanism","label":"自然滞后与释放","definition":"早期加速阶段允许拍头出现相对滞后，接触附近以稳定路径和自然释放而非主动手腕操控获得拍头速度。","domains":["racket_hand_interface","forehand","backhand","serve"],"conditions":[],"evidence_ids":["E-racketflip","E-twohand","E-servefoundation"],"confidence":"medium","status":"cross_video_synthesis","limitations":["可见拍头滞后不等同于单一关节动作；需要高帧率镜头。"],"version":"1.0.0"},
    {"id":"P5.1","node_type":"outcome","label":"甜点接触质量","definition":"球在弦床有效区域、合适拍面与时序下的接触质量，是出球速度、方向与反馈一致性的上游变量。","domains":["contact_geometry","general_principles"],"conditions":[],"evidence_ids":["E-power"],"confidence":"high","status":"channel_teaching_claim","limitations":["普通视频中的甜点命中只能间接推断。"],"version":"1.0.0"},
    {"id":"P5.2","node_type":"principle","label":"速度—旋转—轨迹耦合","definition":"水平出球速度、垂直净空、球拍路径与旋转意图需要共同匹配合法飞行窗口。","domains":["contact_geometry","forehand","serve"],"conditions":[{"field":"task_goal","operator":"in","value":["attack","rally","serve"],"rationale":"目标球形决定权重。"}],"evidence_ids":["E-rotation","E-topspin","E-serveplane"],"confidence":"medium","status":"cross_video_synthesis","limitations":["需要外部标定数据才能量化球速、旋转和空气动力学。"],"version":"1.0.0"},
    {"id":"P6.F","node_type":"technical_template","label":"正手最简有效链","definition":"空间匹配、稳定基座、向外初始路径、自然滞后、接触面稳定、随挥减速与恢复的条件化正手模板。","domains":["forehand"],"conditions":[{"field":"shot_family","operator":"eq","value":"forehand","rationale":"适用于正手技术家族。"}],"evidence_ids":["E-racketflip","E-power","E-forehandrotate"],"confidence":"medium","status":"cross_video_synthesis","limitations":["不是所有球况都需要完整链条。"],"version":"1.0.0"},
    {"id":"P6.B2","node_type":"technical_template","label":"双手反手的解耦与重组","definition":"先以重力环和双手分工获得控制，再按球况整合腿、髋、躯干与肩部输出。","domains":["two_handed_backhand","backhand"],"conditions":[{"field":"shot_family","operator":"eq","value":"two_handed_backhand","rationale":"适用于双手反手。"}],"evidence_ids":["E-twohand","E-twohandtips"],"confidence":"high","status":"channel_teaching_claim","limitations":["左右手主导感受因惯用侧与个体技术不同而变化。"],"version":"1.0.0"},
    {"id":"P6.B1","node_type":"technical_template","label":"单手反手的上背稳定链","definition":"以上背稳定、重力落拍和前方空间构建简单可控的单手反手，并按球况渐进整合。","domains":["one_handed_backhand","backhand"],"conditions":[{"field":"shot_family","operator":"eq","value":"one_handed_backhand","rationale":"适用于单手反手。"}],"evidence_ids":["E-onehand","E-onehandpull"],"confidence":"high","status":"channel_teaching_claim","limitations":["对力量、舒适度和个体适配性敏感。"],"version":"1.0.0"},
    {"id":"P6.S","node_type":"technical_template","label":"发球的肩鞭—旋前链","definition":"由准备几何、肩带弹性、由内向外平面、肩部滚动、前臂旋前与自然减速组成的发球基础模板。","domains":["serve","overhead"],"conditions":[{"field":"shot_family","operator":"in","value":["serve","overhead"],"rationale":"适用于发球与相近的过头击球。"}],"evidence_ids":["E-serveplane","E-servefoundation","E-pronation"],"confidence":"high","status":"cross_video_synthesis","limitations":["不应通过单一视频诊断肩部健康或关节负荷。"],"version":"1.0.0"},
    {"id":"P7.1","node_type":"tactical_pattern","label":"测量型进攻","definition":"在自身接触和恢复能力允许的窗口内，以深度、角度、前移和持续压力逐步提高对手回球难度。","domains":["tactics_decision"],"conditions":[{"field":"task_goal","operator":"eq","value":"attack","rationale":"适用于主动得分建构。"}],"evidence_ids":["E-aggression","E-singles"],"confidence":"medium","status":"cross_video_synthesis","limitations":["需要结合对手、比分和自身一致性；不是每球都应进攻。"],"version":"1.0.0"},
    {"id":"P7.2","node_type":"principle","label":"最简有效版本与渐进叠加","definition":"先最小化变量、建立可重复的接触与路径，再按能力和球况叠加身体环节、移动和对抗压力。","domains":["training_skill_acquisition","general_principles"],"conditions":[{"field":"skill_level","operator":"in","value":["beginner","intermediate","advanced"],"rationale":"所有水平都可用，但进阶尺度不同。"}],"evidence_ids":["E-twohand","E-onehand","E-servefoundation"],"confidence":"high","status":"cross_video_synthesis","limitations":["训练迁移必须经随机球况和比赛压力检验。"],"version":"1.0.0"},
    {"id":"P7.3","node_type":"safety_guardrail","label":"事实—假设—建议分层","definition":"视频系统必须把直接观测、机制假设与教学建议分开表达，并标明证据和置信度。","domains":["vlm","knowledge_management","agent"],"conditions":[],"evidence_ids":["E-channel"],"confidence":"high","status":"cross_video_synthesis","limitations":["需要产品界面和工作流共同执行。"],"version":"1.0.0"}
